{
  "name": "@protecx/js",
  "version": "1.0.0",
  "description": "ProtecX JavaScript SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "author": "Mudit Garg",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "auth",
    "sdk",
    "protecx"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "@types/jsonwebtoken": "^9.0.6"
  }
}